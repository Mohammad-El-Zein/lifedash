# Copy to .env for local development outside Docker.
# For `docker compose up`, edit the .env.example in the repository root instead —
# that is the file Compose reads.
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://lifedash:lifedash@localhost:5432/lifedash
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:4200

# --- AI features (quick capture, life insights) --------------------------------------
# Empty or unset = features off: the endpoints answer 503 and the insights row
# stays hidden. The key is server-side only and never reaches the browser.
ANTHROPIC_API_KEY=
# Optional overrides; the defaults are the cost-efficient choice.
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_TIMEOUT_SECONDS=30
