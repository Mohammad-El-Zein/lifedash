# Copy to .env in this directory:  cp .env.example .env
#
# This is the file Docker Compose reads. It fills in ${...} in docker-compose.yml,
# so it is the one to edit for `docker compose up`. (backend/.env.example is a
# different file, for running the backend directly without Docker.)
#
# .env is git-ignored — never commit it.

# --- AI features (quick capture, life insights) --------------------------------------
# Leave empty to run LifeDash without them: the endpoints answer 503 and the UI
# hides the insights row. Everything else works unchanged.
# Get a key at https://console.anthropic.com/ — it stays server-side and never
# reaches the browser.
ANTHROPIC_API_KEY=

# Optional, defaults to claude-haiku-4-5 (chosen for cost).
# ANTHROPIC_MODEL=claude-haiku-4-5
